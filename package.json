{
  "name": "@polunzh/dsh-task-notifier",
  "version": "1.3.3",
  "description": "任务通知台：任务完成或中断时响提示音并弹系统/浏览器通知，侧边栏「任务」面板可筛选待回复、进行中与未读结果（含退出、欠费中断）。Task-completion chime + system/browser notifications, plus a Tasks sidebar panel that surfaces sessions waiting on your input, running, and unread results, including interruptions.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "preview": "node preview/server.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "notification",
    "notifications",
    "task",
    "task-panel",
    "unread",
    "chime",
    "sidebar",
    "macos",
    "productivity"
  ],
  "author": "polunzh (https://github.com/polunzh)",
  "license": "MIT",
  "homepage": "https://github.com/polunzh/dsh-task-notifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polunzh/dsh-task-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/polunzh/dsh-task-notifier/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
